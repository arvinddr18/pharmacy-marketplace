# Copy this file to .env and fill in real values. NEVER commit .env.

# Server
PORT=5000
NODE_ENV=development

# Database — use a local MongoDB or a MongoDB Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/pharmacy_marketplace

# JWT secrets — generate long random strings, e.g. `openssl rand -hex 48`
JWT_ACCESS_SECRET=change_me_to_a_long_random_string
JWT_REFRESH_SECRET=change_me_to_a_different_long_random_string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ---- Integrations below are NOT active until you add real credentials ----
# OTP / SMS provider (e.g. MSG91, Twilio). Leave blank to use dev console OTP.
OTP_PROVIDER=
# Payment gateway (e.g. Razorpay) sandbox keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Feature flag: live medicine ordering stays OFF until legal clearance
FEATURE_LIVE_ORDERS=false
